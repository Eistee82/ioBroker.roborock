{
  "_meta": {
    "description": "Data-point catalogues and value enums for the Roborock device categories the adapter does NOT support today: roborock.wetdryvac (wet/dry stick vacuum), roborock.wm (washing machine) and roborock.mower (robot lawn mower). Extracted from the category home-card plugin bundles fetched from the Roborock cloud plugin endpoint. Names are the app's own identifiers; numeric values are literal constants read from the decompiled Hermes bytecode.",
    "sources": [
      "roborock.wetdryvac_v1024.zip -> index.android.bundle (Hermes v96, 975512 bytes); project.json: apiLevel 10028, category roborock.wetdryvac, version 1024",
      "roborock.wm_v1034.zip -> index.android.bundle (Hermes v96, 1209320 bytes); project.json: apiLevel 10028, category roborock.wm, version 1034",
      "roborock.mower_v46.zip -> index.android.bundle (Hermes v96, 2806924 bytes); plugin_info: apiLevel 10044, pluginLevel 3002, version 46"
    ],
    "method": "hermes-dec (hbc_decompiler.py) -> register-level pseudo JS; constants read with _appanalysis/plugins/_tools/objlit.js and pbenum.js",
    "confidence": "proven unless a 'confidence' field says otherwise - every value is a literal constant assigned to the named export in the bundle",
    "extractedAt": "2026-08-13",
    "report": "_appanalysis/12-plugins-cloud.md",
    "warning": "DPS numbers are per device family. The same number means different things for the vacuum, the wet/dry vac, the washing machine and the mower. Never share a DPS table across categories."
  },

  "reservedDpType": {
    "description": "DPS ids reserved across the DP-based device families. Present verbatim in both the wetdryvac and the wm bundle; the vacuum home_card does not define them.",
    "confidence": "proven",
    "values": {
      "10000": "QueryDP",
      "10001": "CheckIsFCC",
      "10002": "AutoDryTimer (wetdryvac only)",
      "10003": "SetSoundPackage (wetdryvac only)",
      "10004": "SoundPackageInfo (wetdryvac only)",
      "10005": "GeneralInfo",
      "10006": "PrivacyInfo",
      "10007": "UpdateInfo",
      "10008": "WashHistory (wm only)",
      "10101": "RPCRequest",
      "10102": "RPCResponse"
    },
    "rpcEnvelope": {
      "description": "Payload written to DPS 10101. The plugin builds it as JSON.stringify({id, method}); id = Math.floor(Math.random() * 1000000).",
      "shape": { "id": "<random int 0..999999>", "method": "<string>" }
    },
    "rpcMethods": { "user_upload_log": "UploadLog" }
  },

